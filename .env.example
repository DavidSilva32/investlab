DATABASE_URL=
DATABASE_URL_POOLED=

# Segredo Better Auth (mínimo de 32 caracteres) e URL canônica da aplicação.
BETTER_AUTH_URL=http://localhost:3000
AUTH_SECRET=

# Telefone internacional do suporte no WhatsApp, somente dígitos (ex.: 5521999999999).
SUPPORT_WHATSAPP_NUMBER=

# Login limiter trusts x-real-ip only when the ingress overwrites the header.
# x-forwarded-for is ignored; without x-real-ip, e-mail throttling still applies.

# Token BRAPI usado somente pelo backend (opcional para sandbox; recomendado em producao).
BRAPI_TOKEN=

# Segredo exclusivo do agendador semanal (pelo menos 32 caracteres aleatórios).
# Cadastre no ambiente Production da Vercel; a Vercel envia no header Authorization.
CRON_SECRET=
