DATABASE_URL=
DATABASE_URL_POOLED=

# Segredo Better Auth (mínimo de 32 caracteres) e URL canônica da aplicação.
BETTER_AUTH_URL=http://localhost:3000
# Credenciais legadas temporarias: remova apos o primeiro login ADMIN e a confirmacao do backfill.
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
AUTH_SECRET=

# Login limiter trusts x-real-ip only when the ingress overwrites the header.
# x-forwarded-for is ignored; without x-real-ip, e-mail throttling still applies.

# Token BRAPI usado somente pelo backend (opcional para sandbox; recomendado em producao).
BRAPI_TOKEN=
